{
  "name": "dyad",
  "version": "0.1.0",
  "description": "A serializable superset type system for RDBMS types (Postgres, MySQL, SQLite). Intended as the public type IR for Reylo's inference engine.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./postgres": "./src/postgres/index.ts",
    "./sqlite": "./src/sqlite/index.ts",
    "./mysql": "./src/mysql/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "mysql2": "^3.24.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
